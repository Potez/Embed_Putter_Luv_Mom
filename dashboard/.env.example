# ---------- web (Vite: only VITE_* vars are exposed to the browser) ----------
# From Firebase console > Project settings > Your apps > Web app config.
# These are public identifiers, not secrets — access is enforced by database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=demo-roomsense
VITE_FIREBASE_APP_ID=
# Set to 1 to use the local emulators (npm run emulators)
VITE_USE_EMULATOR=1

# ---------- worker (SECRETS — never commit .env) ----------
FIREBASE_PROJECT_ID=demo-roomsense
FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-roomsense-default-rtdb
# Path to service-account JSON (Firebase console > Service accounts). Not needed with emulator.
GOOGLE_APPLICATION_CREDENTIALS=
# Set when using emulators:
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public URL of the dashboard, used for links in alerts
DASHBOARD_URL=http://localhost:5173

# Telegram: create bot via @BotFather, add it to the staff group, get chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). Gmail: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
